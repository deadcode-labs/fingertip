    "Show in Finder": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar en Finder"
          }
        }
      }
    },
    "Shown while this app is running": {
      "localizations": {
        "es": {
          "stringUnit": {
