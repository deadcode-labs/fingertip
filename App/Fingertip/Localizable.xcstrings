        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar de la lista"
          }
        }
      }
    },
    "Required: reading the screen and acting on it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
